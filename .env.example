# Copy to .env.local (git-ignored) and fill in. Every key is optional in
# development unless it says otherwise; production needs all but Google.

# Postgres. Locally: `bun db:up` starts it (docker-compose.yml). Production: Neon's pooled URL,
# plus its direct one (DATABASE_URL_UNPOOLED), which `bun db:migrate` uses when it's set.
DATABASE_URL=postgres://ink:ink@localhost:5433/ink

# Accounts (lib/auth.ts). Secret: `openssl rand -base64 32`. URL: the app's own origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sign-in emails (lib/email.ts). Without them, development prints the email in the terminal.
RESEND_API_KEY=
EMAIL_FROM="Encre <signin@tryencre.com>"

# Google sign-in: a Web OAuth client, redirect URI <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (lib/ai/models.ts, lib/ai/config.ts): OpenAI's key, or AI Gateway's for every provider.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
INK_AI=

# Dictionary (lib/translate.ts).
GOOGLE_TRANSLATE_API_KEY=

# Payments (lib/billing.ts). Test-mode keys locally (sk_test_…); the webhook
# secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# or in production from the endpoint added in Stripe's dashboard. Without the
# key, /plans says "On sale soon". STRIPE_TAX=on once Stripe Tax is set up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX=
